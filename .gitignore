# Created by https://www.gitignore.io
# place file in ~/.config/git/ignore

### Qt ###
# C++ objects and libs

*.slo
*.lo
*.o
*.a
*.la
*.lai
*.so
*.dll
*.dylib

# Qt-es

/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
# Generated by qmake in the project root; translations-desktop-file/Makefile is kept.
/Makefile*
*-build-*

# QtCreator

*.autosave

#QtCtreator Qml
*.qmlproject.user
*.qmlproject.user.*

# An in-source build's binary, not every path named mx-tools.
/mx-tools

# Build trees, so they never end up in build.sh --arch's tarball of the working tree.
/build/
/obj-*/
/pkg/

# What a Debian package build leaves in debian/.
/debian/mx-tools/
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/*.debhelper.log
/debian/*.substvars

# The translation workflows need these, so keep them even where a global ignore file
# excludes Makefiles or Transifex directories.
!/translations-desktop-file/Makefile
!.tx/
